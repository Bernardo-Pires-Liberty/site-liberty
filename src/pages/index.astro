---
import Layout from "../layouts/Layout.astro";
import ReasonsGrid from "../components/ReasonsGrid.astro";
import FinalCta from "../components/FinalCta.astro";

const stats = [
  { end: 1.3, decimals: 1, unit: "B", label: "em ativos sob negociação", desc: "Confiança do mercado em cada operação conduzida." },
  { end: 13, decimals: 0, unit: "", label: "anos de experiência", desc: "Histórico sólido em fusões, aquisições e finanças corporativas." },
  { end: 16, decimals: 0, unit: "", label: "especialidades", desc: "Uma equipe altamente qualificada, pronta para impulsionar seu negócio." },
];

// Por enquanto só a solução de Fusões e Aquisições está publicada.
const solution = {
  title: "Fusões e Aquisições",
  desc: "Assessoria completa em processos de compra, venda e integração de empresas, da originação ao fechamento.",
  href: "/solucoes/fusoes-e-aquisicoes/",
  icon: "M8 12h8M12 8v8M4 12a8 8 0 1 0 16 0 8 8 0 0 0-16 0z",
  highlights: [
    "Assessoria em compra e venda de empresas",
    "Due diligence e avaliação de empresas",
    "Negociação e fechamento de contratos",
  ],
};

const sectors = [
  {
    title: "Construção Pesada",
    desc: "Soluções seguras e estratégicas para operações complexas no setor.",
    icon: "M4 21V7l8-4 8 4v14M4 21h16M9 21v-6h6v6",
  },
  {
    title: "Saúde",
    desc: "Fusões e aquisições que impulsionam inovação e crescimento sustentável.",
    icon: "M12 21s-7-4.35-9.5-8.5C.5 8.5 3 5 6.5 5c2 0 3.5 1.5 5.5 4 2-2.5 3.5-4 5.5-4 3.5 0 6 3.5 4 7.5C19 16.65 12 21 12 21z",
  },
  {
    title: "Mineração e Siderurgia",
    desc: "Atuação estratégica em operações complexas e de grande porte.",
    icon: "M3 20 9 8l4 6 3-4 5 10H3z",
  },
  {
    title: "Agronegócio",
    desc: "Inteligência em M&A para fortalecer e expandir negócios do campo.",
    icon: "M5 21c0-9 6-15 15-15 0 9-6 15-15 15zM5 21c0-4 2-7 5-9",
  },
  {
    title: "Logística e Varejo",
    desc: "Eficiência e estratégia para movimentar negócios com alto desempenho.",
    icon: "M3 7h11v9H3zM14 11h4l3 3v2h-7zM6.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM17.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z",
  },
  {
    title: "TI",
    desc: "Apoio completo em M&A para empresas de tecnologia.",
    icon: "M7 7h10v10H7zM9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3",
  },
];

---

<Layout
  title="Assessoria em Fusões e Aquisições (M&A) | Liberty Negócios"
  description="A Liberty Negócios é especialista em maximizar o valor do seu negócio por meio de estratégias inteligentes de M&A, finanças corporativas e estratégia empresarial. Mais de 13 anos de experiência e R$1,3 bi em ativos negociados."
>
  <!-- Hero -->
  <section class="hero">
    <svg class="hero__pattern" viewBox="0 0 800 600" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
      <circle cx="620" cy="140" r="220" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" />
      <circle cx="700" cy="380" r="150" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" />
      <circle cx="560" cy="470" r="90" fill="none" stroke="rgba(77,127,214,0.35)" stroke-width="1.5" />
      <path d="M420 40 L780 40" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
      <path d="M460 90 L780 90" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
    </svg>
    <div class="container hero__inner">
      <p class="kicker kicker--light hero__anim" style="--d: 0s">M&A vai além da assinatura</p>
      <h1 class="hero__anim" style="--d: 0.1s">Fusões e Aquisições</h1>
      <p class="hero__lead hero__anim" style="--d: 0.2s">
        A Liberty Negócios é especialista em maximizar o valor do seu negócio por meio
        de estratégias inteligentes de M&A e gestão financeira.
      </p>
      <div class="hero__actions hero__anim" style="--d: 0.3s">
        <a href="/contato/" class="btn btn--primary">Fale com um especialista</a>
        <a href="/quem-somos/" class="btn btn--outline btn--outline-light">Conheça nossa metodologia</a>
      </div>
    </div>
  </section>

  <!-- Quem Somos -->
  <section class="section">
    <div class="container about">
      <div data-reveal>
        <p class="kicker">Quem Somos</p>
        <h2>
          Na Liberty Negócios entendemos que uma transação
          <span class="text-blue">de M&A vai além da assinatura</span>
        </h2>
      </div>
      <div class="about__side" data-reveal style="--reveal-delay: 0.15s">
        <p>
          Com mais de 13 anos de experiência, atuamos com foco em gerar valor real para
          nossos clientes, conduzindo negócios com excelência, segurança e resultados
          concretos. Nosso compromisso é impulsionar o crescimento de empresas por meio
          de oportunidades sólidas e relacionamentos duradouros.
        </p>
        <a href="/quem-somos/" class="btn btn--primary">Saiba mais</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section section--soft stats">
    <div class="container stats__grid">
      {stats.map((s, i) => (
        <div class="stat hover-lift" data-reveal style={`--reveal-delay: ${i * 0.12}s`}>
          <p
            class="stat__value"
            data-counter-end={s.end}
            data-counter-decimals={s.decimals}
            data-counter-unit={s.unit}
            data-counter-prefix="+"
          >
            +0{s.unit}
          </p>
          <p class="stat__label">{s.label}</p>
          <p class="stat__desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Soluções -->
  <section class="solutions">
    <div class="container solutions__layout">
      <div data-reveal>
        <p class="kicker kicker--light">O que fazemos</p>
        <h2 class="solutions__title">Soluções estratégicas para impulsionar seu negócio</h2>
        <p class="solutions__intro">
          Hoje concentramos nossa atuação em Fusões e Aquisições — novas frentes de
          especialização serão publicadas aqui em breve.
        </p>
      </div>

      <div class="solutions__card hover-lift" data-reveal style="--reveal-delay: 0.15s">
        <span class="solutions__icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d={solution.icon}></path>
          </svg>
        </span>
        <p class="solutions__card-title">{solution.title}</p>
        <p>{solution.desc}</p>
        <ul class="solutions__highlights">
          {solution.highlights.map((item) => <li>{item}</li>)}
        </ul>
        <a href={solution.href} class="btn btn--ghost btn--ghost-light">Saiba Mais <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Setores de Atuação -->
  <section class="section">
    <div class="container">
      <p class="kicker kicker--center" data-reveal>Setores de Atuação</p>
      <h2 class="section__title" data-reveal style="--reveal-delay: 0.1s">
        Oferecemos soluções em M&A personalizadas
        <span class="text-blue">para empresas de diversos segmentos</span>
      </h2>

      <div class="sectors">
        {sectors.map((sector, i) => (
          <div class="sector hover-lift" data-reveal style={`--reveal-delay: ${(i % 3) * 0.1}s`}>
            <span class="sector__icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={sector.icon}></path>
              </svg>
            </span>
            <h3>{sector.title}</h3>
            <p>{sector.desc}</p>
          </div>
        ))}
      </div>

      <div class="section__cta">
        <a href="/contato/" class="btn btn--primary">Vamos conversar</a>
      </div>
    </div>
  </section>

  <!-- O que defendemos -->
  <ReasonsGrid />

  <!-- CTA final -->
  <FinalCta />

  <!-- Blog -->
  <section class="section">
    <div class="container blog-preview">
      <div class="blog-preview__header">
        <div>
          <p class="kicker">Blog</p>
          <h2>Insights do mercado</h2>
        </div>
        <a href="/blog/" class="btn btn--outline">Acessar Blog</a>
      </div>

      <article class="blog-card hover-lift" data-reveal>
        <p class="blog-card__category">E-commerce</p>
        <time class="blog-card__date" datetime="2026-09-22">22 de setembro de 2026</time>
        <h3>
          <a href="/blog/ma-ecommerce/">
            Marketplaces e Varejo Online: a consolidação que impulsiona o M&A em e-commerce no Brasil
          </a>
        </h3>
        <a href="/blog/ma-ecommerce/" class="btn btn--ghost">Leia Agora <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(155deg, rgba(10, 22, 48, 0.82) 0%, rgba(10, 22, 48, 0.75) 60%, rgba(28, 63, 122, 0.75) 100%),
      url("../assets/entradaLiberty.png") center / cover no-repeat;
    color: var(--color-white);
    padding: 120px 0 100px;
  }

  .hero__pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__anim {
    opacity: 0;
    animation: hero-in 0.7s ease forwards;
    animation-delay: var(--d, 0s);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__anim {
      opacity: 1;
      animation: none;
    }
  }

  .kicker--light {
    color: #9dc0f7;
  }

  .kicker--light::before {
    background: #9dc0f7;
  }

  .hero h1 {
    color: var(--color-white);
    font-size: clamp(2.4rem, 5vw, 3.4rem);
  }

  .hero__lead {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.05rem;
    max-width: 480px;
  }

  .hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .btn--outline-light {
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .btn--outline-light:hover {
    border-color: var(--color-white);
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .about h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .about__side p {
    font-size: 0.95rem;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: center;
  }

  .stat {
    background: var(--color-white);
    border-radius: 16px;
    padding: 32px 24px;
    box-shadow: 0 4px 20px rgba(40, 48, 71, 0.06);
  }

  .stat__value {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--color-blue);
    margin-bottom: 4px;
  }

  .stat__label {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 8px;
  }

  .stat__desc {
    font-size: 0.85rem;
    max-width: 260px;
    margin: 0 auto;
  }

  .solutions {
    background: linear-gradient(155deg, var(--color-navy-deep) 0%, var(--color-navy) 100%);
    color: var(--color-white);
    padding: 80px 0;
  }

  .solutions__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .solutions__title {
    color: var(--color-white);
    max-width: 480px;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .solutions__intro {
    color: rgba(255, 255, 255, 0.7);
    max-width: 440px;
    font-size: 0.95rem;
    margin: 0;
  }

  .solutions__card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 36px;
  }

  .solutions__highlights {
    list-style: none;
    margin: 20px 0 24px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .solutions__highlights li {
    position: relative;
    padding-left: 22px;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .solutions__highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #9dc0f7;
  }

  .solutions__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(77, 127, 214, 0.2);
    color: #9dc0f7;
    margin-bottom: 20px;
  }

  .solutions__card-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-white);
    margin-bottom: 4px;
  }

  .btn--ghost-light {
    color: #9dc0f7;
  }

  .sectors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .sector {
    padding: 28px;
    border-radius: 16px;
    border: 1px solid rgba(40, 48, 71, 0.08);
  }

  .sector__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-bg-light);
    color: var(--color-blue);
    margin-bottom: 16px;
  }

  .sector h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
  }

  .sector p {
    font-size: 0.9rem;
    margin: 0;
  }

  .blog-preview__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .blog-card {
    background: var(--color-bg-soft);
    border-radius: 16px;
    padding: 28px;
    max-width: 560px;
  }

  .blog-card__category {
    display: inline-block;
    background: var(--color-bg-light);
    color: var(--color-blue);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 10px;
  }

  .blog-card__date {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text);
    margin-bottom: 10px;
  }

  .blog-card h3 {
    font-size: 1.15rem;
    margin-bottom: 16px;
  }

  .blog-card h3 a:hover {
    color: var(--color-blue);
  }

  @media (max-width: 900px) {
    .about,
    .stats__grid,
    .solutions__layout,
    .sectors {
      grid-template-columns: 1fr;
    }

    .hero {
      padding: 90px 0 64px;
    }
  }

  @media (min-width: 601px) and (max-width: 900px) {
    .sectors {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
