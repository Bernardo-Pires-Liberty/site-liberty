---
// Shorter hero used on inner pages (Quem Somos, Equipe, Soluções, etc.),
// reusing the same navy/blue pattern language as the homepage hero.
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="page-hero">
  <svg class="page-hero__pattern" viewBox="0 0 800 400" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
    <circle cx="620" cy="80" r="180" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" />
    <circle cx="700" cy="280" r="130" fill="none" stroke="rgba(77,127,214,0.3)" stroke-width="1.5" />
    <path d="M420 40 L780 40" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
  </svg>
  <div class="container page-hero__inner" data-reveal>
    <h1>{title}</h1>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(155deg, rgba(10, 22, 48, 0.82) 0%, rgba(10, 22, 48, 0.75) 60%, rgba(28, 63, 122, 0.75) 100%),
      url("../assets/entradaLiberty.png") center / cover no-repeat;
    color: var(--color-white);
    padding: 96px 0;
    text-align: center;
  }

  .page-hero__pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: var(--color-white);
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 0.4em;
  }

  .page-hero__subtitle {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.05rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .page-hero {
      padding: 72px 0;
    }
  }
</style>
