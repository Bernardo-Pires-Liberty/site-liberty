---
// Por enquanto só existe a página de Fusões e Aquisições — adicionar aqui
// conforme as próximas soluções forem publicadas.
const solucoes = [{ label: "Fusões e Aquisições", href: "/solucoes/fusoes-e-aquisicoes/" }];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="topbar">
    <div class="container topbar__inner">
      <a href="mailto:libertynegocios@libertynegocios.com.br">libertynegocios@libertynegocios.com.br</a>
      <a href="tel:+553132485000">(31) 3248-2500</a>
    </div>
  </div>

  <div class="navbar">
    <div class="container navbar__inner">
      <a href="/" class="logo" aria-label="Liberty Negócios — página inicial">
        <span class="logo__main">Liberty</span>
        <span class="logo__sub">Negócios</span>
      </a>

      <nav class="nav" aria-label="Navegação principal">
        <ul class="nav__list">
          <li><a href="/" class:list={{ active: currentPath === "/" }}>Home</a></li>
          <li><a href="/quem-somos/" class:list={{ active: currentPath.startsWith("/quem-somos") }}>Quem Somos</a></li>
          <li><a href="/equipe/" class:list={{ active: currentPath.startsWith("/equipe") }}>Equipe</a></li>
          <li class="nav__dropdown" class:list={{ "is-active": currentPath.startsWith("/solucoes") }}>
            <button type="button" class="nav__dropdown-trigger" aria-haspopup="true" aria-expanded="false">
              Soluções <span aria-hidden="true">▾</span>
            </button>
            <ul class="nav__dropdown-menu">
              {solucoes.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </li>
          <li><a href="/blog/" class:list={{ active: currentPath.startsWith("/blog") }}>Blog</a></li>
          <li><a href="/contato/" class:list={{ active: currentPath.startsWith("/contato") }}>Contato</a></li>
        </ul>
      </nav>

      <a href="/contato/" class="btn btn--primary navbar__cta">Solicite uma proposta</a>

      <button type="button" class="navbar__toggle" aria-label="Abrir menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .topbar {
    background: var(--color-navy);
    color: var(--color-white);
    font-size: 0.85rem;
  }

  .topbar__inner {
    display: flex;
    justify-content: flex-end;
    gap: 24px;
    padding: 8px 24px;
  }

  .topbar__inner a {
    opacity: 0.85;
  }

  .topbar__inner a:hover {
    opacity: 1;
  }

  .navbar {
    background: var(--color-white);
    box-shadow: 0 1px 0 rgba(40, 48, 71, 0.08);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: box-shadow 0.25s ease;
  }

  .navbar.is-scrolled {
    box-shadow: 0 8px 24px rgba(40, 48, 71, 0.1);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 14px;
    padding-bottom: 14px;
    transition: padding 0.25s ease;
  }

  .navbar.is-scrolled .navbar__inner {
    padding-top: 8px;
    padding-bottom: 8px;
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    flex-shrink: 0;
  }

  .logo__main {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--color-navy);
  }

  .logo__sub {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-top: 2px;
  }

  .nav {
    flex: 1;
  }

  .nav__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-navy);
  }

  .nav__list > li > a {
    position: relative;
    display: inline-block;
    padding: 4px 0;
    transition: color 0.2s ease;
  }

  .nav__list > li > a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background: var(--color-blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav__list a.active {
    color: var(--color-blue);
  }

  .nav__list a.active::after {
    transform: scaleX(1);
  }

  .nav__list > li > a:hover {
    color: var(--color-blue);
  }

  .nav__list > li > a:hover::after {
    transform: scaleX(1);
  }

  .nav__dropdown {
    position: relative;
  }

  .nav__dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    font: inherit;
    color: var(--color-navy);
    cursor: pointer;
    padding: 8px 0;
  }

  .nav__dropdown.is-active .nav__dropdown-trigger {
    color: var(--color-blue);
  }

  .nav__dropdown-trigger span {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .nav__dropdown:hover .nav__dropdown-trigger span,
  .nav__dropdown.is-expanded .nav__dropdown-trigger span {
    transform: rotate(180deg);
  }

  .nav__dropdown-menu {
    list-style: none;
    margin: 0;
    padding: 8px;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-white);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(40, 48, 71, 0.15);
    min-width: 240px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }

  .nav__dropdown:hover .nav__dropdown-menu,
  .nav__dropdown:focus-within .nav__dropdown-menu {
    opacity: 1;
    visibility: visible;
  }

  .nav__dropdown-menu a {
    display: block;
    padding: 10px 12px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .nav__dropdown-menu a:hover {
    background: var(--color-bg-light);
    color: var(--color-blue);
  }

  .navbar__cta {
    flex-shrink: 0;
  }

  .navbar__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .navbar__toggle span {
    width: 22px;
    height: 2px;
    background: var(--color-navy);
  }

  @media (max-width: 960px) {
    .nav,
    .navbar__cta {
      display: none;
    }

    .navbar.is-open .nav {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-white);
      box-shadow: 0 12px 24px rgba(40, 48, 71, 0.12);
      padding: 16px 24px;
    }

    .navbar.is-open .nav__list {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .navbar.is-open .navbar__cta {
      display: inline-flex;
      margin-top: 16px;
    }

    .navbar.is-open .nav__dropdown-menu {
      position: static;
      transform: none;
      opacity: 1;
      visibility: visible;
      box-shadow: none;
      display: none;
      padding-left: 12px;
    }

    .navbar.is-open .nav__dropdown.is-expanded .nav__dropdown-menu {
      display: block;
    }

    .navbar__toggle {
      display: flex;
    }

    .navbar {
      position: relative;
    }

    .topbar__inner {
      justify-content: center;
      flex-wrap: wrap;
      text-align: center;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".navbar__toggle");
  const navbar = document.querySelector<HTMLElement>(".navbar");
  const dropdownTrigger = document.querySelector<HTMLButtonElement>(".nav__dropdown-trigger");
  const dropdown = document.querySelector<HTMLElement>(".nav__dropdown");

  toggle?.addEventListener("click", () => {
    const isOpen = navbar?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  dropdownTrigger?.addEventListener("click", () => {
    const isExpanded = dropdown?.classList.toggle("is-expanded");
    dropdownTrigger.setAttribute("aria-expanded", String(Boolean(isExpanded)));
  });

  const setScrolled = () => navbar?.classList.toggle("is-scrolled", window.scrollY > 8);
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });
</script>
